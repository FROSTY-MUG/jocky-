# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
